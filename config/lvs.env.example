# config/lvs.env.example — VSS LVS .env overlay (02 config contract).
# Secrets exist ONLY as placeholders here (04); the real file is
# generated at prep. The LVS .env path moves between releases — the prep
# script locates it (`find . -name '.env' -path '*lvs*'`) and overlays
# these values (02).
MODE=2d
BP_PROFILE=bp_developer_lvs
HARDWARE_PROFILE=H100
LLM_MODE=remote                # value verified at prep (CLI equivalent: --use-remote-llm)
VLM_MODE=local_shared
VLM_DEVICE_ID='0'
VSS_AGENT_VERSION=3.2.1
VSS_AGENT_CONFIG_FILE=<PLACEHOLDER: in-VM path where prep places the repo's config_rag.yml>
LLM_ENDPOINT_URL='http://auth-shim:8080'
RAG_SERVER_URL='http://rag-server:8081/v1'
KNOWLEDGE_COLLECTION='demo_corpus'
VSS_DATA_DIR=/data/vss-apps-data
VSS_APPS_DIR=<PLACEHOLDER>
HOST_IP=<PLACEHOLDER>
NGC_CLI_API_KEY=<PLACEHOLDER>
NVIDIA_API_KEY=<PLACEHOLDER>
RAG_API_KEY=<PLACEHOLDER>
