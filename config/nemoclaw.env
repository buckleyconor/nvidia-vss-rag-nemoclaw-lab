# config/nemoclaw.env — NemoClaw provider override (02 config contract).
# COMPATIBLE_API_KEY is a safe constant, not a credential (04): the shim
# discards the Bearer value and substitutes the real x-api-key.
NEMOCLAW_PROVIDER=custom
NEMOCLAW_ENDPOINT_URL=http://auth-shim:8080/v1
COMPATIBLE_API_KEY=dummy
# OpenShell gateway port: the CLI default (8080) is the auth-shim's
# docker-proxy port ("multiple listeners", 2026-09-10 dry-run); health and
# metrics ride +1/+2 (8086/8087). Read by 40-nemoclaw.sh, the heal ladder
# and scripts/demo/03-agent-kickoff.sh.
NEMOCLAW_GATEWAY_PORT=8085
