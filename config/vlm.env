# config/vlm.env — VSS VLM budget (02 config contract). Applied at prep
# via `dev-profile.sh up ... --vlm-env-file`. The 0.40 fraction of the
# 96 GB card leaves the rest for the RAG stack (09 co-residency budget).
NIM_PASSTHROUGH_ARGS=--gpu-memory-utilization 0.40 --max-model-len 32768 --max-num-seqs 4
