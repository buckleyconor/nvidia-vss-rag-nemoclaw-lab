# config/rag.env — RAG APP_* values (02 config contract). No secrets in
# this file (04): RAG_API_KEY is prep-injected into the RAG stack's own
# .env. ENABLE_AGENTIC_RAG is off — it would multiply shared-endpoint
# calls (02).
APP_LLM_MODELNAME=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
APP_LLM_SERVERURL=auth-shim:8080
APP_VECTORSTORE_NAME=elasticsearch
APP_EMBEDDINGS_MODELNAME=nvidia/llama-nemotron-embed-1b-v2
# The lab runs the text-embedding NIM (nemotron-embedding-ms), not the vlm
# variant — so the embedding endpoint must point at it. The RAG v2.6.2
# compose default is the vlm variant (the text-embed alternative is its
# commented-out line); the blueprint's deploy/compose/.env also points at
# the vlm variant, which is why 20-start.sh exports this file instead of
# sourcing the blueprint .env.
APP_EMBEDDINGS_SERVERURL=nemotron-embedding-ms:8000/v1
APP_RANKING_MODELNAME=nvidia/llama-nemotron-rerank-1b-v2
MODEL_DIRECTORY=/data/nim-cache
ENABLE_AGENTIC_RAG=off
