# mock-wo outbound clients — real per-VM values (gitignored per 04; template:
# config/mock-wo.env.example). Sourced by 20-start.sh with `set -a` before the
# mock-wo compose up (same pattern as lab.env — never --env-file).
#
# Values verified on this VM 2026-09-13 (operator-dashboard-spec O2/O22):
#   OPENCLAW_HOOK_URL/TOKEN — the lab hook relay on the demo-net gateway IP.
#     OpenClaw 2026.7.1 (NemoClaw v0.0.118) has NO /hooks/wake endpoint
#     (404 on the dashboard port; only the five internal lifecycle hooks),
#     so the relay translates the wake POST into `nemoclaw demo agent`.
#     The token is the sandbox gateway token (`nemoclaw demo gateway-token`);
#     it survives restarts but must be re-written after a clean re-onboard
#     (heal-ladder tier 3) — same refresh as /root/.config/lab/nemoclaw-hook-token.
#   VSS_AGENT_URL — vss-agent runs on the host network and serves :8000
#     (POST /generate — the vss-ask-video skill surface).
#   VST_URL — VSS video storage/transfer on host :30888 (the v3.2.1 skill's
#     /vst/api/v1/sensor/list + /storage/file/<name> surface; sensor list
#     verified with the seeded Retail-Food_Court_Scene clip).
OPENCLAW_HOOK_URL=http://host.docker.internal:18790
OPENCLAW_HOOK_TOKEN=<REDACTED-PASTE-TOKEN-HERE>
VSS_AGENT_URL=http://host.docker.internal:8000
VST_URL=http://host.docker.internal:30888
