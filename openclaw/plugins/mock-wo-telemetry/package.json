{
  "name": "mock-wo-telemetry",
  "version": "0.1.0",
  "private": true,
  "description": "OpenClaw plugin: forwards tool-call and model-output hook events to mock-wo's agent port (operator-dashboard-spec ADR-V09).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": { "pluginApi": ">=2026.5.22" },
    "build": { "openclawVersion": "2026.5.27" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "openclaw": "2026.5.27",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
